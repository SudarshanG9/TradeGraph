# Private server connection; never use a NEXT_PUBLIC_ prefix for credentials.
FASTAPI_BASE_URL=http://127.0.0.1:8000
# Exact browser origin used to validate cookie-authenticated mutations.
APP_ORIGIN=http://127.0.0.1:3000
# Optional mock preview ONLY under next dev; production always uses live mode.
TRADEGRAPH_MODE=live
# Always open the exact APP_ORIGIN (localhost and 127.0.0.1 are different origins).

# Shared frontend sessions (server-only). No in-memory fallback.
REDIS_URL=redis://127.0.0.1:6379/0
# Generate a 32-byte key: openssl rand -hex 32. Share across frontend instances.
# Rotate only with an intentional logout of existing sessions.
SESSION_ENCRYPTION_KEY=

# Production requires explicit HTTPS APP_ORIGIN, e.g. https://tradegraph.example.
# Development alone defaults to http://127.0.0.1:3000.
# Controlled production-mode local tests ONLY may set this with a loopback origin:
# ALLOW_INSECURE_LOOPBACK_ORIGIN=true
