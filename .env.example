# Native services only. Keep existing .env; copy only when configuring a new clone.
POSTGRES_DB=tradegraph
POSTGRES_PORT=5432
# Day 1 admin scripts default to the OS user and /tmp socket; libpq uses .pgpass.
POSTGRES_ADMIN_HOST=/tmp
# POSTGRES_ADMIN_USER=your_native_admin_user
# Legacy setup/owner variables; never used as runtime credential fallbacks.
POSTGRES_USER=tradegraph_owner
POSTGRES_PASSWORD=replace_with_owner_password

POSTGRES_HOST=/tmp
POSTGRES_RUNTIME_USER=tradegraph_financial
POSTGRES_RUNTIME_PASSWORD=replace_with_runtime_password

REDIS_URL=redis://127.0.0.1:6379/0
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_neo4j_password

JWT_SECRET=replace_with_at_least_32_random_secret_characters
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=900
HEALTH_TIMEOUT_SECONDS=3
HEALTH_INTERVAL_SECONDS=10
EVENT_QUEUE_CAPACITY=1024
SERVICE_WORKERS=1

# Opt-in maintenance; deploy bounded_archive migration/index before enabling.
MAINTENANCE_ENABLED=false
MAINTENANCE_INTERVAL_SECONDS=60
ARCHIVE_AGE_SECONDS=86400
MAINTENANCE_BATCH_SIZE=100
MAINTENANCE_RETRIES=3
MAINTENANCE_RETRY_SECONDS=1
# Optional nonfinancial vector retention: disabled by default; requires explicit scope.
REGIME_RETENTION_SECONDS=0
REGIME_RETENTION_INSTRUMENT_IDS=

# Approved isolated database identity boundary. Deploy role/RLS migration first;
# cut over all API/financial/admin paths together during controlled maintenance.
DATABASE_IDENTITY_MODE=isolated
# When set to isolated, all three service credentials must be distinct/nonprivileged.
POSTGRES_AUTH_USER=
POSTGRES_AUTH_PASSWORD=
POSTGRES_COMPLIANCE_USER=
POSTGRES_COMPLIANCE_PASSWORD=
# Private mode-0600 manifest created by scripts/setup_database_identity.py.
TRADER_DATABASE_CREDENTIALS_FILE=
